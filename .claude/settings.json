{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "playwright@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run serve)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(python3 scripts/serve.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "mcp__plugin_playwright_playwright",
      "mcp__plugin_context7_context7"
    ],
    "deny": [
      "Bash(git push --force *)"
    ]
  }
}
